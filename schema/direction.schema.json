{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "unit": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "properties": {
        "bg": {
          "type": "string"
        },
        "bgm": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "anchor": {
                "type": "string"
              }
            },
            "required": ["id", "anchor"],
            "additionalProperties": false
          },
          "do": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "cmd": {
                      "type": "string",
                      "const": "bg"
                    },
                    "id": {
                      "type": "string"
                    },
                    "transition": {
                      "type": "string",
                      "enum": ["fade", "cut", "wipe"]
                    },
                    "ms": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": ["cmd", "id"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "cmd": {
                      "type": "string",
                      "const": "show"
                    },
                    "char": {
                      "type": "string"
                    },
                    "expr": {
                      "type": "string",
                      "enum": [
                        "neutral",
                        "smile",
                        "laugh",
                        "surprised",
                        "angry",
                        "sad",
                        "thinking",
                        "embarrassed"
                      ]
                    },
                    "slot": {
                      "type": "string",
                      "enum": [
                        "center",
                        "left",
                        "right",
                        "far-left",
                        "far-right"
                      ]
                    }
                  },
                  "required": ["cmd", "char", "expr", "slot"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "cmd": {
                      "type": "string",
                      "const": "expr"
                    },
                    "char": {
                      "type": "string"
                    },
                    "expr": {
                      "type": "string",
                      "enum": [
                        "neutral",
                        "smile",
                        "laugh",
                        "surprised",
                        "angry",
                        "sad",
                        "thinking",
                        "embarrassed"
                      ]
                    }
                  },
                  "required": ["cmd", "char", "expr"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "cmd": {
                      "type": "string",
                      "const": "move"
                    },
                    "char": {
                      "type": "string"
                    },
                    "slot": {
                      "type": "string"
                    },
                    "ms": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": ["cmd", "char", "slot"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "cmd": {
                      "type": "string",
                      "const": "hide"
                    },
                    "char": {
                      "type": "string"
                    }
                  },
                  "required": ["cmd", "char"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "cmd": {
                      "type": "string",
                      "const": "bgm"
                    },
                    "id": {
                      "type": "string"
                    },
                    "fade": {
                      "type": "number",
                      "minimum": 0
                    },
                    "volume": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": ["cmd", "id"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "cmd": {
                      "type": "string",
                      "const": "se"
                    },
                    "id": {
                      "type": "string"
                    },
                    "volume": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": ["cmd", "id"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "cmd": {
                      "type": "string",
                      "const": "board"
                    },
                    "op": {
                      "type": "string",
                      "enum": [
                        "clear",
                        "pin",
                        "unpin",
                        "highlight",
                        "fade-older"
                      ]
                    }
                  },
                  "required": ["cmd", "op"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "cmd": {
                      "type": "string",
                      "const": "card"
                    },
                    "kind": {
                      "type": "string",
                      "enum": ["location", "title", "chapter"]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": ["cmd", "kind", "text"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "cmd": {
                      "type": "string",
                      "const": "fx"
                    },
                    "kind": {
                      "type": "string",
                      "enum": ["shake", "flash", "vignette", "blur"]
                    },
                    "ms": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": ["cmd", "kind", "ms"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "cmd": {
                      "type": "string",
                      "const": "wait"
                    },
                    "ms": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": ["cmd", "ms"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "cmd": {
                      "type": "string",
                      "const": "set"
                    },
                    "flag": {
                      "type": "string"
                    },
                    "value": {
                      "type": ["boolean", "number", "string"]
                    }
                  },
                  "required": ["cmd", "flag", "value"],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": ["at", "do"],
        "additionalProperties": false
      }
    }
  },
  "required": ["unit", "cues"],
  "additionalProperties": false
}
