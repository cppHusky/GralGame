{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "gralgame-save"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "scriptHash": {
      "type": "string"
    },
    "bookCommit": {
      "type": "string"
    },
    "savedAt": {
      "type": "string"
    },
    "state": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "number",
          "const": 1
        },
        "cursor": {
          "type": "object",
          "properties": {
            "lesson": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "beat": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "page": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["lesson", "unit", "beat", "page"],
          "additionalProperties": false
        },
        "stage": {
          "type": "object",
          "properties": {
            "bg": {
              "type": "string"
            },
            "sprites": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "char": {
                    "type": "string"
                  },
                  "expr": {
                    "type": "string"
                  },
                  "slot": {
                    "type": "string"
                  },
                  "dim": {
                    "type": "boolean"
                  }
                },
                "required": ["char", "expr", "slot", "dim"],
                "additionalProperties": false
              }
            }
          },
          "required": ["sprites"],
          "additionalProperties": false
        },
        "board": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "math": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": ["eq", "fig"]
                  },
                  "pinned": {
                    "type": "boolean"
                  }
                },
                "required": ["math", "kind", "pinned"],
                "additionalProperties": false
              }
            }
          },
          "required": ["items"],
          "additionalProperties": false
        },
        "read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": "string",
          "enum": ["normal", "auto", "skip"]
        }
      },
      "required": ["schema", "cursor", "stage", "board", "read", "mode"],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "version",
    "scriptHash",
    "bookCommit",
    "savedAt",
    "state"
  ],
  "additionalProperties": false
}
